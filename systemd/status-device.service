[Unit]
Description=Indicador de CPU, GPU y RAM en la barra superior
Documentation=https://github.com/cesardev31/status_device
PartOf=graphical-session.target
After=graphical-session.target
# El indicador solo tiene sentido con sesión gráfica; si GNOME aún no ha
# levantado el shell, systemd reintenta unas cuantas veces.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Opciones extra sin tocar esta unidad: escribe STATUS_DEVICE_ARGS en
# ~/.config/status-device/env (por ejemplo: STATUS_DEVICE_ARGS=-warn 60 -crit 85)
EnvironmentFile=-%h/.config/status-device/env
ExecStart=%h/.local/bin/status-device $STATUS_DEVICE_ARGS
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
